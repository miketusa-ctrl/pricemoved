SESSION_SECRET=<set-locally>
POLAR_WEBHOOK_SECRET=<set-locally>
POLAR_ACCESS_TOKEN=<set-locally>
# Local default for full product e2e. Production wrangler.toml uses waitlist.
LAUNCH_MODE=full
